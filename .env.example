# Copy to .env (or configure these in your host); never commit real values.
DISCORD_TOKEN=
BOT_OWNER_ID=0
OPENROUTER_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
EDENAI_API_KEY=
DASHBOARD_ENABLED=false
DASHBOARD_PORT=8080
# Set these only when intentionally exposing the dashboard. Use a unique 32+ character value.
